  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "test": "bun test",
    "typecheck": "bun check --no-script",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun run test && bun run build",
    "cf:build": "DEPLOY_TARGET=cloudflare vite build",
    "cf:preview": "DEPLOY_TARGET=cloudflare vite build && DEPLOY_TARGET=cloudflare vite preview",
    "cf:deploy": "wrangler deploy",
    "deploy": "DEPLOY_TARGET=cloudflare vite build && wrangler deploy"
  },
